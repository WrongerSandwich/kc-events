{
  "name": "kc-events-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "generate": "tsx src/build/generate.ts",
    "dev": "pnpm generate && astro dev",
    "build": "pnpm generate && astro build",
    "size": "tsx scripts/size-check.ts",
    "generate-and-build": "pnpm generate && astro build",
    "build:e2e": "SITE_TODAY=2026-10-05 SITE_DATASET=e2e/fixtures/events.json SITE_VENUES=e2e/fixtures/venues.yaml SITE_OUT_DIR=dist-e2e pnpm generate-and-build",
    "preview": "astro preview",
    "preview:e2e": "SITE_OUT_DIR=dist-e2e astro preview --port 4321 --ignore-lock",
    "typecheck": "SITE_TODAY=last-run pnpm generate && astro check",
    "test": "SITE_TODAY=last-run pnpm generate && vitest run",
    "test:coverage": "SITE_TODAY=last-run pnpm generate && vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.8",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
