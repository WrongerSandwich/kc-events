---
import { kindIcons } from "../lib/kind-icons";
// The eleven kind icons as symbols, once per page; KindIcon draws them with <use>.
---
<svg xmlns="http://www.w3.org/2000/svg" style="display: none" aria-hidden="true">
  {Object.entries(kindIcons).map(([slug, inner]) => (
    <symbol id={`kind-icon-${slug}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={inner} />
  ))}
</svg>
