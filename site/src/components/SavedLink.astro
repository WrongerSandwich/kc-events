---
// The plain link; the script beneath adds the count of saves still to come once the page has loaded (#195: plain
// script, so a page with no island loads no Svelte runtime).
---
<a href="/explore?saved=1" data-saved-link>Saved</a>

<script>
  import { showSavedCount } from "./header";
  import { saves } from "../lib/saves";

  const link = document.querySelector<HTMLAnchorElement>("[data-saved-link]");
  if (link) showSavedCount(link, saves());
</script>

<style>
  /* The count is the script's element, so it is reached with :global. */
  a :global(.count) { display: inline-block; min-width: 1.25rem; margin-left: 0.35em; padding: 0 0.35em; border-radius: 999px; background: var(--accent); color: var(--accent-fg); font-size: var(--text-xs); font-weight: var(--weight-strong); text-align: center; font-variant-numeric: tabular-nums; }
</style>
