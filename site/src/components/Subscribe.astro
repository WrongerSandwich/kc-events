---
import CopyButton from "./CopyButton.svelte";
import { PICKS_FEED, webcalUrl } from "../lib/feeds";

// The picks' feed (#136), two ways (#188): the webcal link opens Apple Calendar's subscribe dialog, but Android and
// most Windows browsers have nothing for that scheme, so the https address is beside it with a one-tap copy, for an app
// that asks for a URL (Google Calendar, Outlook). Phones put the address first (first in the source too, so Tab order matches). The page passes the build's origin.
interface Props { origin: string }
const { origin } = Astro.props;
const address = new URL(PICKS_FEED, origin);
// The address may break after a slash, and only there, so a phone wraps it between its parts rather than mid-word (#184).
const parts = [`${address.origin}/`, ...address.pathname.slice(1).split(/(?<=\/)/)];
---
<div class="subscribe-ways">
  <p class="by-address">
    For Google Calendar or Outlook, add it by address: <code>{parts.map((p, i) => <>{i > 0 && <wbr />}{p}</>)}</code> <CopyButton client:load label="Copy address" url={address.toString()} />
    Google Calendar: Other calendars, From URL.
  </p>
  <p class="apple">
    <a href={webcalUrl(origin, PICKS_FEED)}>Subscribe to the picks</a> in Apple Calendar or any app that opens calendar
    links. It updates weekly; remove the calendar to stop.
  </p>
</div>

<style>
  .subscribe-ways { display: flex; flex-direction: column; gap: var(--space-2); }
  .subscribe-ways p { margin: 0; }
  /* The address is first in the source, so reading and Tab order match a phone's; wider screens lead with the link. */
  @media (min-width: 30.0625rem) {
    .apple { order: -1; }
  }
  /* Breaks inside a part only when that part alone is wider than the line. */
  code { overflow-wrap: break-word; user-select: all; }
</style>
