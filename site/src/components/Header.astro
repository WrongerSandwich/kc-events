---
import { meta } from "../generated/meta";
import { formatDay, localDate } from "../lib/dates";
import { siteConfig } from "../site.config";

// `wide` matches the header's width to the page's main column (the explorer is wide; everything else is the measure).
interface Props { wide?: boolean }
const { wide = false } = Astro.props;
const runDay = localDate(meta.lastSuccessfulRun);
---
<header class="site-header">
  <a class="skip" href="#main">Skip to content</a>
  <div class:list={["inner", wide ? "wide" : "measure"]}>
    <div class="top">
      <a class="name" href="/">{siteConfig.name}</a>
      <nav aria-label="Site">
        <a href="/explore">Explore</a>
        <a href="/about">About</a>
      </nav>
    </div>
    <p class="stamp">Researched weekly; last run <time datetime={runDay}>{formatDay(runDay)}</time></p>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); margin-bottom: var(--space-8); }
  .inner { padding-block: var(--space-4) var(--space-3); }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .name { font-size: var(--text-lg); font-weight: 700; letter-spacing: -0.01em; color: var(--fg); }
  .name:hover { text-decoration: none; color: var(--accent); }
  nav { display: flex; gap: var(--space-4); font-size: var(--text-sm); }
  nav a { color: var(--fg-muted); }
  nav a:hover { color: var(--fg); }
  .stamp { margin-top: var(--space-1); font-size: var(--text-xs); color: var(--fg-faint); }
  .skip {
    position: absolute; left: var(--gutter); top: var(--space-2); z-index: 10;
    transform: translateY(-200%);
    background: var(--bg-raised); color: var(--fg); border: 1px solid var(--rule); border-radius: var(--radius);
    padding: var(--space-2) var(--space-3); font-size: var(--text-sm);
  }
  .skip:focus { transform: none; }
</style>
