---
import { siteConfig } from "../site.config";

interface Props { wide?: boolean }
const { wide = false } = Astro.props;
---
<footer class="site-footer">
  <div class:list={["inner", wide ? "wide" : "measure"]}>
    <p>No ads, no accounts, no tracking.</p>
    <ul>
      <li><a href="/about">How this is made</a></li>
      <li><a href="/events.json">The dataset</a></li>
      <li><a href={siteConfig.repoUrl}>Source on GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-12); border-top: 1px solid var(--rule); font-size: var(--text-sm); color: var(--fg-muted); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6); padding-block: var(--space-6) var(--space-8); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); list-style: none; padding: 0; margin: 0; }
  a { color: var(--fg-muted); text-decoration: underline; text-decoration-color: var(--fg-faint); }
  a:hover { color: var(--fg); text-decoration-color: currentColor; }
</style>
