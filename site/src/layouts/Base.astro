---
import "@fontsource-variable/geist";
import "../styles/tokens.css";
import "../styles/base.css";
import { siteConfig } from "../site.config";
import { origin } from "../build/origin";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StalenessBanner from "../components/StalenessBanner.svelte";
import IconSprite from "../components/IconSprite.astro";

interface Props { title: string; description: string; canonical?: string; jsonLd?: object; wide?: boolean }
const { title, description, canonical, jsonLd, wide = false } = Astro.props;
const fullTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
// build.format "file" yields /e/<id>.html and /index.html; the public URLs are extensionless.
const publicPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const url = canonical ?? new URL(publicPath, origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL("/og.png", origin).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <IconSprite />
    <Header wide={wide}><StalenessBanner client:load wide={wide} /></Header>
    <main id="main" class={wide ? "wide" : "measure"}>
      <slot />
    </main>
    <Footer wide={wide} />
    <script>
      import { meta } from "../generated/meta";
      import { todayIn } from "../lib/dates";
      import { faviconSvg } from "../lib/favicon";
      // The tab's icon shows today's date in the site's zone; again on return, so a tab left open overnight rolls over.
      const icon = document.querySelector<HTMLLinkElement>('link[rel="icon"]')!;
      const show = () => { icon.href = `data:image/svg+xml,${encodeURIComponent(faviconSvg(Number(todayIn(meta.timeZone, new Date()).slice(8))))}`; };
      show();
      document.addEventListener("visibilitychange", show);
    </script>
  </body>
</html>
