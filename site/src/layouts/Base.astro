---
import "@fontsource-variable/geist";
import "@fontsource/josefin-sans/700.css";
import "../styles/tokens.css";
import "../styles/base.css";
import { siteConfig } from "../site.config";
import { origin } from "../build/origin";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StalenessBanner from "../components/StalenessBanner.svelte";
import IconSprite from "../components/IconSprite.astro";
import Analytics from "@vercel/analytics/astro";

interface Props { title: string; description: string; canonical?: string; jsonLd?: object; wide?: boolean }
const { title, description, canonical, jsonLd, wide = false } = Astro.props;
const fullTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
// build.format "file" yields /e/<id>.html and /index.html; the public URLs are extensionless.
const publicPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const url = canonical ?? new URL(publicPath, origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <!-- Safari draws no SVG icon and takes the ICO; the others take the SVG, listed after it. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL("/og.png", origin).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <!-- Vercel Web Analytics: cookieless page views; its script is served from the deployment, so local and e2e builds send nothing. -->
    <Analytics />
  </head>
  <body>
    <IconSprite />
    <Header wide={wide}><StalenessBanner client:load wide={wide} /></Header>
    <main id="main" class={wide ? "wide" : "measure"}>
      <slot />
    </main>
    <Footer wide={wide} />
  </body>
</html>
