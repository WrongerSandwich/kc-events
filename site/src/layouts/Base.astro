---
import "@fontsource-variable/geist";
import "@fontsource/josefin-sans/700.css";
import "../styles/tokens.css";
import "../styles/base.css";
import { siteConfig } from "../site.config";
import { origin } from "../build/origin";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StalenessBanner from "../components/StalenessBanner.svelte";
import IconSprite from "../components/IconSprite.astro";
import Analytics from "@vercel/analytics/astro";

/** noindex: a page no search engine should list (the 404), which then names no canonical URL either. */
interface Props { title: string; description: string; canonical?: string; jsonLd?: object; wide?: boolean; noindex?: boolean }
const { title, description, canonical, jsonLd, wide = false, noindex = false } = Astro.props;
const fullTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
// build.format "file" yields /e/<id>.html and /index.html; the public URLs are extensionless.
const publicPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const url = canonical ?? new URL(publicPath, origin).toString();
// public/og.png, the one share card (scripts/share-image.html): its size, and what it says.
const shareImage = { url: new URL("/og.png", origin).toString(), width: 1200, height: 630, alt: `${siteConfig.name}: ${siteConfig.tagline}` };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <!-- Safari draws no SVG icon and takes the ICO; the others take the SVG, listed after it. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={url} />}
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <IconSprite />
    <Header wide={wide}><StalenessBanner client:load wide={wide} /></Header>
    <main id="main" class={wide ? "wide" : "measure"}>
      <slot />
    </main>
    <Footer wide={wide} />
    <!-- Vercel Web Analytics: cookieless page views; its script is served from the deployment, so local and e2e builds
         send nothing. In the body, not the head: its custom element would end the head early, and with it the CSP meta
         Astro appends there. -->
    <Analytics />
  </body>
</html>
