---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import { siteConfig } from "../site.config";
import { origin, shareImage } from "../build/origin";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StalenessBanner from "../components/StalenessBanner.svelte";
import IconSprite from "../components/IconSprite.astro";
import Analytics from "@vercel/analytics/astro";
// The one face every page sets its text in, latin subset, and the wordmark's: preloaded so they are not found only once
// the CSS is parsed, and the name does not paint in the fallback first (#195).
import geistLatin from "../fonts/geist-latin-wght-400-600.woff2?url";
import wordmark from "../fonts/wordmark-700.woff2?url";

/** noindex: a page no search engine should list (the 404), which then names no canonical URL either. */
/** jsonLd: one object, or several, each in a script of its own (an event page's Event and its BreadcrumbList). */
interface Props { title: string; description: string; canonical?: string; jsonLd?: object | object[]; wide?: boolean; noindex?: boolean }
const { title, description, canonical, jsonLd, wide = false, noindex = false } = Astro.props;
const ldBlocks = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const fullTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
// build.format "file" yields /e/<id>.html and /index.html; the public URLs are extensionless.
const publicPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const url = canonical ?? new URL(publicPath, origin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Both schemes from the first paint, so a dark-mode reader gets no white flash, and the browser's bars in each
        scheme's background: tokens.css's --bg, oklch(0.985 0 0) and oklch(0.17 0 0), in hex (#188; audit A20, D14). */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f0f0f" />
    <title>{fullTitle}</title>
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={wordmark} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <!-- Safari draws no SVG icon and takes the ICO; the others take the SVG, listed after it. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={url} />}
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <link rel="sitemap" href="/sitemap.xml" />
    {ldBlocks.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, "\\u003c")} />)}
  </head>
  <body>
    <IconSprite />
    <Header><StalenessBanner client:idle /></Header>
    {/* Focusable, so the skip link moves focus here in every browser, not only where it moves the sequential start
        point (audit 2026-10-21, A13); base.css draws it no ring. */}
    <main id="main" class={wide ? "wide" : "measure"} tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Vercel Web Analytics: cookieless page views; its script is served from the deployment, so local and e2e builds
         send nothing. In the body, not the head: its custom element would end the head early, and with it the CSP meta
         Astro appends there. -->
    <Analytics />
  </body>
</html>
