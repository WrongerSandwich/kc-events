---
import Base from "../../layouts/Base.astro";
import UiIcon from "../../components/UiIcon.svelte";
import VenueEvents from "../../components/VenueEvents.svelte";
import { origin } from "../../build/origin";
import { about } from "../../generated/about";
import { events } from "../../generated/events";
import { meta } from "../../generated/meta";
import { venues } from "../../generated/venues";
import { hostOf, neighborhoodLine, samePlace } from "../../lib/events";
import type { PublishedEvent, PublishedVenue } from "../../lib/types";
import { venueDescription, venueFacts, venuePageJsonLd, venuePageTitle } from "../../lib/venue-page";
import { addressLine, mapUrl, venueSlug } from "../../lib/venues";
import "../../styles/venues.css";

export function getStaticPaths() {
  return venues.map((venue) => ({ params: { slug: venue.slug }, props: { venue, events: events.filter((e) => venueSlug(e.venue) === venue.slug) } }));
}
const { venue, events: here } = Astro.props as { venue: PublishedVenue; events: PublishedEvent[] };

// Under the venue's name, a neighborhood of the same name says only its region (#186).
const hood = venue.neighborhood === undefined ? undefined : neighborhoodLine(samePlace(venue.neighborhood, venue.name) ? venue.region! : venue.neighborhood, venue.region!);
// The title says the page is a listing (#300); the h1 stays the venue's name.
const title = venuePageTitle(venue);
const description = venueDescription(venue, here, meta.buildToday);
const facts = venueFacts(here, meta.buildToday, about.horizonWeeks);
const jsonLd = venuePageJsonLd(venue, here, { origin, today: meta.buildToday });
const map = mapUrl(venue);
---
<Base title={title} description={description} jsonLd={jsonLd} wide>
  <header class="venue-head">
    <h1>{venue.name}</h1>
    {venue.address !== undefined && <p>{addressLine(venue.address)}</p>}
    {hood !== undefined && <p class="venue-hood">{hood}</p>}
    {(map !== undefined || venue.url !== undefined) && (
      <p class="venue-links">
        {map !== undefined && <a href={map}><UiIcon name="map-pin" />Map</a>}
        {venue.url !== undefined && <a href={venue.url}><UiIcon name="link" />{hostOf(venue.url)}</a>}
      </p>
    )}
  </header>
  {facts.length > 0 && <p class="venue-facts">{facts.join(" · ")}</p>}
  <section aria-label={`Events at ${venue.name}`}>
    <VenueEvents events={here} />
  </section>
  {/* The venue's own way in (#188): For venues says how to correct a listing or ask for a calendar page to be read. */}
  <p class="venue-all"><a href="/about#for-venues">Is this your venue? How to correct a listing</a> · <a href="/venues">All venues</a></p>
</Base>
