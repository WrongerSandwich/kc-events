---
import Base from "../../layouts/Base.astro";
import UiIcon from "../../components/UiIcon.svelte";
import VenueEvents from "../../components/VenueEvents.svelte";
import { origin } from "../../build/origin";
import { events } from "../../generated/events";
import { venues } from "../../generated/venues";
import { hostOf, neighborhoodLine } from "../../lib/events";
import type { PublishedEvent, PublishedVenue } from "../../lib/types";
import { addressLine, mapUrl, venueJsonLd, venueSlug } from "../../lib/venues";
import "../../styles/venues.css";

export function getStaticPaths() {
  return venues.map((venue) => ({ params: { slug: venue.slug }, props: { venue, events: events.filter((e) => venueSlug(e.venue) === venue.slug) } }));
}
const { venue, events: here } = Astro.props as { venue: PublishedVenue; events: PublishedEvent[] };

const hood = venue.neighborhood === undefined ? undefined : neighborhoodLine(venue.neighborhood, venue.region!);
const where = venue.address !== undefined ? addressLine(venue.address) : venue.neighborhood;
const description = `${here.length === 0 ? "Events at" : "Upcoming events at"} ${venue.name}${where === undefined ? "" : `, ${where}`}.`;
const jsonLd = venueJsonLd(venue, new URL(`/v/${venue.slug}`, origin).toString());
const map = mapUrl(venue);
---
<Base title={venue.name} description={description} jsonLd={jsonLd} wide>
  <header class="venue-head">
    <h1>{venue.name}</h1>
    {venue.address !== undefined && <p>{addressLine(venue.address)}</p>}
    {hood !== undefined && <p class="venue-hood">{hood}</p>}
    {(map !== undefined || venue.url !== undefined) && (
      <p class="venue-links">
        {map !== undefined && <a href={map}><UiIcon name="map-pin" />Map</a>}
        {venue.url !== undefined && <a href={venue.url}><UiIcon name="link" />{hostOf(venue.url)}</a>}
      </p>
    )}
  </header>
  <section aria-label={`Events at ${venue.name}`}>
    <VenueEvents events={here} />
  </section>
  {/* The way to the directory: a footer link would weigh on every page, the front page's and the explorer's budgets. */}
  <p class="venue-all"><a href="/venues">All venues</a></p>
</Base>
