---
import Base from "../layouts/Base.astro";
import { events } from "../generated/events";
import { meta } from "../generated/meta";
import { venues } from "../generated/venues";
import { addressLine, venueDirectory } from "../lib/venues";
import { slugify } from "../lib/slugs";
import "../styles/venues.css";

// Every venue page (#137), by region; built with no script, like the venue pages themselves.
const groups = venueDirectory(venues, events, meta.regions);
---
<Base title="Venues" description={`${venues.length} venues in and around Kansas City, by region, each with what's coming up there.`}>
  <div class="directory">
    <h1>Venues</h1>
    <p class="lede">{venues.length} venues, by region. Each one's page lists what's coming up there.</p>

    {groups.map((g) => (
      <section aria-labelledby={`r-${slugify(g.heading)}`}>
        <h2 id={`r-${slugify(g.heading)}`} class="section-heading">{g.heading}</h2>
        <ul>
          {g.venues.map(({ venue, events: count }) => (
            <li>
              <a href={`/v/${venue.slug}`}>{venue.name}</a>
              <span class="detail">{[count > 0 ? `${count} ${count === 1 ? "event" : "events"}` : undefined, venue.neighborhood !== venue.name && venue.neighborhood].filter(Boolean).join(" · ")}</span>
              {venue.address !== undefined && <span class="detail">{addressLine(venue.address)}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
