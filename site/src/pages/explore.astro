---
import Base from "../layouts/Base.astro";
import Explorer from "../components/Explorer.svelte";
import { events } from "../generated/events";
import { QUERY_KEYS } from "../lib/query";
const description = `Every one of ${events.length} active Kansas City events, by date, kind, and region.`;
---
<Base title="Explore" description={description} wide>
  <h1>Explore</h1>
  <!-- The explorer filters in the browser, so without JavaScript every link shows every event; say so, and hide the
       phone's Filters button, which could not open. -->
  <noscript>
    <p class="no-js">Filters need JavaScript. Without it, this page lists every event, whatever the link asked for.</p>
    <style is:inline>.sheet-toggle { display: none !important; }</style>
  </noscript>
  <!-- The server HTML is the unfiltered view, so a filtered link would paint every event and then swap to its slice
       on hydration. Before anything below is parsed, a link that asks for a slice holds the explorer and the footer
       hidden (laid out, so nothing visible shifts) until the explorer releases them on mount, or three seconds pass
       without it. Without JavaScript this never runs, and the notice above explains the full list. -->
  <script is:inline define:vars={{ keys: QUERY_KEYS }}>
    const params = new URLSearchParams(location.search);
    if (keys.some((k) => params.has(k))) {
      document.documentElement.dataset.slice = "pending";
      setTimeout(() => { delete document.documentElement.dataset.slice; }, 3000);
    }
  </script>
  <Explorer client:load />
</Base>
<style>
  h1 { font-size: var(--text-2xl); margin: var(--space-8) 0 var(--space-4); }
  :global(:root[data-slice="pending"] :is(.explorer, .site-footer)) { visibility: hidden; }
  .no-js { color: var(--fg-muted); font-size: var(--text-sm); margin: 0 0 var(--space-4); }
</style>
