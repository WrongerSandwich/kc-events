---
import Base from "../layouts/Base.astro";
import Explorer from "../components/Explorer.svelte";
import { events } from "../generated/events";
const description = `Every one of ${events.length} active Kansas City events, by date, kind, and region.`;
---
<Base title="Explore" description={description} wide>
  <h1>Explore</h1>
  <!-- The explorer filters in the browser, so without JavaScript every link shows every event; say so, and hide the
       phone's Filters button, which could not open. -->
  <noscript>
    <p class="no-js">Filters need JavaScript. Without it, this page lists every event, whatever the link asked for.</p>
    <style is:inline>.sheet-toggle { display: none !important; }</style>
  </noscript>
  <Explorer client:load />
</Base>
<style>
  h1 { font-size: var(--text-2xl); margin: var(--space-8) 0 var(--space-4); }
  .no-js { color: var(--fg-muted); font-size: var(--text-sm); margin: 0 0 var(--space-4); }
</style>
