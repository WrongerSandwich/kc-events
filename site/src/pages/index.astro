---
import Base from "../layouts/Base.astro";
import DontMissList from "../components/DontMissList.svelte";
import { events } from "../generated/events";
import { siteConfig } from "../site.config";
import { alwaysTherePicks } from "../always-there";
import { pickAlwaysThere } from "../lib/always-there";

const alwaysThere = pickAlwaysThere(events, alwaysTherePicks);
// Everything the explorer holds, recurring included, since the link turns recurring on.
const count = events.length;
---
<Base title={siteConfig.name} description={siteConfig.tagline}>
  <h1>What's on in Kansas City</h1>
  <p class="lede">
    A short list of what's worth going out of your way for, each with a line on why. Every date is read from the
    event's own page; <a href="/about">here's how</a>.
  </p>

  <DontMissList client:load />

  {alwaysThere.length > 0 && <section aria-labelledby="always">
    <h2 id="always" class="section-heading">Always there</h2>
    <p class="note">On a schedule, week in and week out.</p>
    <ul class="always">
      {alwaysThere.map((e) => (
        <li>
          <a href={`/e/${e.id}`}>{e.title}</a>
          <span class="when">{e.schedule}</span>
          <span class="where">{e.venue}</span>
        </li>
      ))}
    </ul>
  </section>}

  <p class="explore"><a href="/explore?recurring=1">Browse all {count} events</a></p>
</Base>

<style>
  h1 { margin-top: var(--space-8); }
  .lede { color: var(--fg-muted); margin-top: var(--space-2); max-width: 36rem; }
  .note { color: var(--fg-muted); margin-top: var(--space-1); }
  .always { list-style: none; padding: 0; margin: var(--space-3) 0 0; }
  .always li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 var(--space-4); align-items: baseline;
    padding-block: var(--space-2); border-bottom: 1px solid var(--rule);
  }
  .always li:last-child { border-bottom: 0; }
  .always a { color: var(--fg); font-weight: var(--weight-strong); }
  .always .when { font-size: var(--text-sm); color: var(--fg-muted); text-align: right; max-width: 18rem; }
  .always .where { grid-column: 1 / -1; font-size: var(--text-sm); color: var(--fg-muted); }
  /* Narrow screens: one column, so a long schedule phrase never squeezes the title. */
  @media (max-width: 34rem) {
    .always li { grid-template-columns: minmax(0, 1fr); }
    .always .when { text-align: left; max-width: none; }
  }
  .explore { margin-block: var(--space-12); font-size: var(--text-lg); font-weight: var(--weight-strong); }
</style>
