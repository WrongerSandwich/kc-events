---
import Base from "../layouts/Base.astro";
import DontMissList from "../components/DontMissList.svelte";
import KindIcon from "../components/KindIcon.svelte";
import Subscribe from "../components/Subscribe.astro";
import UiIcon from "../components/UiIcon.svelte";
import { events } from "../generated/events";
import { dontMiss } from "../generated/dont-miss";
import { meta } from "../generated/meta";
import { origin } from "../build/origin";
import { frontPageJsonLd } from "../lib/event-meta";
import { bucketDontMiss, HORIZONS } from "../lib/horizon";
import { siteConfig } from "../site.config";
import { alwaysTherePicks } from "../always-there";
import { alwaysThereDetail, pickAlwaysThere } from "../lib/always-there";
import { slugify } from "../lib/slugs";
import { kindName, kindPath, regionPath } from "../lib/landing";

const alwaysThere = pickAlwaysThere(events, alwaysTherePicks);
// Everything the explorer holds, recurring included, since the link turns recurring on.
const count = events.length;
// The picks as the page renders them at build: each horizon's in turn.
const buckets = bucketDontMiss(dontMiss, meta.buildToday);
const jsonLd = frontPageJsonLd(HORIZONS.flatMap((h) => buckets[h]), origin, meta.lastSuccessfulRun);
---
<Base title="Kansas City events this week" description={siteConfig.tagline} jsonLd={jsonLd}>
  <h1>What's on in Kansas City</h1>
  <p class="lede">
    The picks worth going out of your way for, chosen and explained by a model under written rules. Every date is read
    from the venue's or organizer's own page; <a href="/about">here's how</a>.
  </p>

  <DontMissList client:load />

  {alwaysThere.length > 0 && <section aria-labelledby="always">
    <h2 id="always" class="section-heading">Always there</h2>
    <p class="note">On a regular schedule, for whenever you want to go.</p>
    <ul class="always">
      {alwaysThere.map((e) => (
        <li class={`kind-${slugify(e.kind)}`}>
          <a href={`/e/${e.id}`}><span class="icon"><KindIcon kind={e.kind} /></span>{e.title}<span class="visually-hidden">, {kindName(e.kind).toLowerCase()}</span></a>
          <span class="detail">{alwaysThereDetail(e)}</span>
        </li>
      ))}
    </ul>
  </section>}

  {/* After the events, soonest to always there, rather than among them: a way to keep the picks, not one of them.
      Named apart from a card's "Add to calendar", which is one event's file; this is a feed that keeps itself up. */}
  <section class="subscribe" aria-labelledby="calendar">
    <h2 id="calendar" class="section-heading">The picks as a calendar</h2>
    <Subscribe origin={origin} />
  </section>

  {/* The widest door, everything in the explorer, before the narrower ones. */}
  <p class="explore"><a href="/explore?when=all&recurring=1">Browse all {count} events</a></p>
  {/* Every kind and region page, linked from here (#188), folded so nineteen links are not a wall at the page's end;
      the venues are in the footer. Open, each list is a column of rows a thumb can hit. */}
  <details class="lists">
    <summary><UiIcon name="chevron-right" />Lists by kind and region</summary>
    <nav aria-label="More lists">
      <p class="group" id="by-kind">By kind</p>
      <ul aria-labelledby="by-kind">{meta.kinds.map((k) => <li><a href={kindPath(k)}>{kindName(k)}</a></li>)}</ul>
      <p class="group" id="by-region">By region</p>
      <ul aria-labelledby="by-region">{meta.regions.map((r) => <li><a href={regionPath(r)}>{r}</a></li>)}</ul>
    </nav>
  </details>
</Base>

<style>
  h1 { margin-top: var(--space-8); }
  /* Phones: the heading steps down a size and sits closer, so the first section starts on the first screen; the
     section headings step down with it (base.css), so it stays one above them (#184). */
  @media (max-width: 30rem) {
    h1 { font-size: var(--text-2xl); margin-top: var(--space-6); }
    .lede { font-size: var(--text-sm); }
  }
  .lede { color: var(--fg-muted); margin-top: var(--space-2); max-width: 36rem; }
  .note { color: var(--fg-muted); margin-top: var(--space-1); }
  .always { list-style: none; padding: 0; margin: var(--space-2) 0 0; }
  /* Two lines a row: the name, then when and where. Schedules run long ("Saturdays & Sundays, April–November; …"),
     so they get the full width rather than a narrow right-hand column. */
  /* The icon gets its own column and the link shares the row's columns, so the detail line starts exactly where the
     title's text does, whatever the two lines' font sizes. */
  .always li { display: grid; grid-template-columns: auto 1fr; column-gap: var(--space-2); padding-block: var(--space-2); border-bottom: 1px solid var(--rule); }
  .always li:last-child { border-bottom: 0; }
  .always a { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: baseline; color: var(--fg); font-weight: var(--weight-medium); }
  .always .detail { grid-column: 2; font-size: var(--text-sm); color: var(--fg-muted); }
  .icon { color: var(--hue); }
  .explore { margin-top: var(--space-12); font-size: var(--text-lg); font-weight: var(--weight-strong); }
  /* The lists: a muted line with a chevron that turns, as Which to use and the started fold. */
  .lists { margin: var(--space-2) 0 var(--space-6); font-size: var(--text-sm); color: var(--fg-muted); }
  .lists summary {
    display: flex; align-items: center; gap: var(--space-2); min-height: var(--tap); width: fit-content;
    font-weight: var(--weight-medium); cursor: pointer; list-style: none;
  }
  .lists summary::-webkit-details-marker { display: none; }
  .lists summary:hover { color: var(--fg); }
  .lists summary :global(.ui-icon) { transition: transform 150ms var(--ease-out); }
  .lists[open] summary :global(.ui-icon) { transform: rotate(90deg); }
  .lists .group { margin-top: var(--space-3); font-size: var(--text-xs); font-weight: var(--weight-medium); }
  /* Columns of rows, each 32 px tall: a list to pick from with a thumb, not a paragraph of links. */
  .lists ul { list-style: none; padding: 0; margin: var(--space-1) 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); column-gap: var(--space-4); }
  .lists li a { display: flex; align-items: center; min-height: 2rem; color: var(--fg); }
  @media (prefers-reduced-motion: reduce) { .lists summary :global(.ui-icon) { transition: none; } }
</style>
