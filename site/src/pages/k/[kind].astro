---
import Landing from "../../components/Landing.astro";
import { origin } from "../../build/origin";
import { about } from "../../generated/about";
import { events } from "../../generated/events";
import { meta } from "../../generated/meta";
import { kindLanding, landingJsonLd, landingRange } from "../../lib/landing";
import { slugify } from "../../lib/slugs";

// One page per kind (#138), a kind with nothing listed among them.
export function getStaticPaths() {
  const range = landingRange(meta.buildToday, about.horizonWeeks);
  return meta.kinds.map((kind) => ({ params: { kind: slugify(kind) }, props: { page: kindLanding(kind, events, meta.buildToday, range) } }));
}
const { page } = Astro.props;
---
<Landing page={page} jsonLd={landingJsonLd(page, origin, meta.lastSuccessfulRun)} />
