---
import Base from "../../layouts/Base.astro";
import KindChip from "../../components/KindChip.svelte";
import DateTile from "../../components/DateTile.svelte";
import UiIcon from "../../components/UiIcon.svelte";
import { dateTile } from "../../lib/tile";
import { slugify } from "../../lib/slugs";
import EventPageIsland from "../../components/EventPageIsland.svelte";
import { origin } from "../../build/origin";
import { events } from "../../generated/events";
import { meta } from "../../generated/meta";
import { formatDay, formatShort, localDate } from "../../lib/dates";
import { eventDescription, eventJsonLd } from "../../lib/event-meta";
import { longDateLine } from "../../lib/date-line";
import { firstDay, hasStartDay, hostOf, isDated, lastDay, detailsUrl } from "../../lib/events";
import { siteConfig } from "../../site.config";
import type { PublishedEvent } from "../../lib/types";

export function getStaticPaths() {
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props as { event: PublishedEvent };

const line = longDateLine(event, meta.buildToday);
const description = eventDescription(event, meta.buildToday);
// The reader lands on the event's own page when the job found one; the verified line still names the list it was read from.
const details = detailsUrl(event);
const reportBody = [`Event: ${origin}/e/${event.id}`, `Primary page: ${event.primaryUrl}`, ...(event.eventUrl ? [`Event page: ${event.eventUrl}`] : []), "", "What is wrong:", ""].join("\n");
const reportUrl = `${siteConfig.repoUrl}/issues/new?title=${encodeURIComponent(`Wrong listing: ${event.title}`)}&body=${encodeURIComponent(reportBody)}`;
const moreLikeThis = events
  .filter((e) => e.id !== event.id && e.kind === event.kind && hasStartDay(e) && firstDay(e)! >= meta.buildToday)
  .sort((a, b) => firstDay(a)!.localeCompare(firstDay(b)!) || a.title.localeCompare(b.title))
  .slice(0, 5);
const jsonLd = eventJsonLd(event);
---
<Base title={event.title} description={description} jsonLd={jsonLd}>
  <article class={`event kind-${slugify(event.kind)}`}>
    <header class:list={["head", { dated: isDated(event) }]}>
      {/* The same tile as the front page's card, by the same view-transition name, so one glides into the other. */}
      {isDated(event) && <DateTile tile={dateTile(event, meta.buildToday)} id={event.id} large />}
      <div>
        <p class="kind"><KindChip kind={event.kind} />{event.dontMiss && <span class="dont-miss">Don't miss</span>}</p>
        <h1 style={`view-transition-name: title-${event.id}`}>{event.title}</h1>
        <p class="date">{line}</p>
        {/* A neighborhood that is its own region (Lawrence, Elsewhere in the metro) is named once. */}
        <p class="where">{event.venue} · {event.neighborhood}{event.region !== event.neighborhood && ` · ${event.region}`}</p>
      </div>
    </header>
    {event.whyLine && <p class="why">{event.whyLine}</p>}
    <p class="primary"><a href={details}>Details and tickets at {hostOf(details)}</a></p>
    <div class="actions">
      <EventPageIsland client:load id={event.id} title={event.title} lastDay={lastDay(event)} />
      {isDated(event) && <a class="ics" href={`/e/${event.id}.ics`} download><UiIcon name="calendar-plus" />Add to calendar</a>}
    </div>
    <p class="verified">Date and venue verified {formatShort(localDate(event.lastVerified))} from {event.eventUrl ? <a href={event.primaryUrl}>the list at {hostOf(event.primaryUrl)}</a> : "the page linked above"}. <a href={reportUrl}>Wrong? Report it</a>.</p>
  </article>

  {moreLikeThis.length > 0 && (
    <section aria-labelledby="more">
      <h2 id="more" class="section-heading">More like this</h2>
      <ul>
        {moreLikeThis.map((e) => (
          <li><a href={`/e/${e.id}`}>{e.title}</a> <span>{formatDay(firstDay(e)!)} · {e.venue}</span></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .event { margin-top: var(--space-8); }
  .head { margin-bottom: var(--space-4); }
  .head.dated { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-4); align-items: start; }
  .kind { display: flex; gap: var(--space-2); align-items: center; margin: 0; }
  h1 { font-size: var(--text-2xl); line-height: var(--leading-tight); margin: var(--space-2) 0; }
  .date { font-size: var(--text-lg); margin: 0; }
  .where { color: var(--fg-muted); margin: 0; }
  .why { margin: 0 0 var(--space-4); font-size: var(--text-lg); color: var(--fg-muted); max-width: 38rem; }
  .primary { font-size: var(--text-lg); margin: 0 0 var(--space-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-bottom: var(--space-6); }
  /* Add to calendar as a button beside Save, the card's pair spelled out. */
  .ics {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap); padding-inline: var(--space-3);
    border: 1px solid var(--control-border); border-radius: var(--radius); background: var(--bg-raised);
    color: var(--fg); font-size: var(--text-sm); font-weight: var(--weight-medium); text-decoration: none;
  }
  .ics:hover { border-color: var(--fg-faint); text-decoration: none; }
  .verified { font-size: var(--text-xs); color: var(--fg-faint); }
  ul { list-style: none; padding: 0; } li { padding: var(--space-1) 0; } li span { font-size: var(--text-xs); color: var(--fg-faint); }
  /* A link followed by text on the same line must not rely on colour alone (axe link-in-text-block). */
  li a { text-decoration: underline; }
</style>
