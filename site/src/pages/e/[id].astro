---
import Base from "../../layouts/Base.astro";
import KindChip from "../../components/KindChip.svelte";
import DateTile from "../../components/DateTile.svelte";
import UiIcon from "../../components/UiIcon.svelte";
import { dateTile } from "../../lib/tile";
import { slugify } from "../../lib/slugs";
import EventPageIsland from "../../components/EventPageIsland.svelte";
import { origin, shareImage } from "../../build/origin";
import { events } from "../../generated/events";
import { descriptions } from "../../generated/descriptions";
import { venues } from "../../generated/venues";
import { venueNamed, venuePath } from "../../lib/venues";
import { meta } from "../../generated/meta";
import { formatDay, formatShort, localDate } from "../../lib/dates";
import { eventDescription, eventJsonLd, eventPageTitle } from "../../lib/event-meta";
import { breadcrumbJsonLd, kindName, kindPath } from "../../lib/landing";
import { longDateLine } from "../../lib/date-line";
import { admissionLine, firstDay, hasStartDay, hostOf, isDated, lastDay, detailsUrl, neighborhoodLine, neighborhoodShown, venueLine, verifiedWhat } from "../../lib/events";
import ReportForm from "../../components/ReportForm.astro";
import { googleCalendarUrl, locatedForCalendar } from "../../lib/ics";
import { siteConfig } from "../../site.config";
import type { PublishedEvent } from "../../lib/types";

export function getStaticPaths() {
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props as { event: PublishedEvent };

const line = longDateLine(event, meta.buildToday);
const description = descriptions[event.id];
const metaDescription = eventDescription(event, meta.buildToday, description);
// The reader lands on the event's own page when the job found one; the verified line still names the list it was read from.
const details = detailsUrl(event);
const report = { title: event.title, event: `${origin}/e/${event.id}`, primaryUrl: event.primaryUrl, ...(event.eventUrl && { eventUrl: event.eventUrl }) };
const moreLikeThis = events
  .filter((e) => e.id !== event.id && e.kind === event.kind && hasStartDay(e) && firstDay(e)! >= meta.buildToday)
  .sort((a, b) => firstDay(a)!.localeCompare(firstDay(b)!) || a.title.localeCompare(b.title))
  .slice(0, 5);
const admission = admissionLine(event);
const venue = venueNamed(venues, event.venue);
const eventLd = eventJsonLd(event, { origin, today: meta.buildToday, description, image: shareImage.url, ...(venue !== undefined && { venue }) });
const jsonLd = [...(eventLd === undefined ? [] : [eventLd]), breadcrumbJsonLd(event, origin)];
// Google Calendar on Android opens no .ics, so its template link sits beside the download (#188); nothing is sent until tapped.
const google = isDated(event) ? googleCalendarUrl(locatedForCalendar(venues, event), siteConfig.name) : undefined;
---
<Base title={eventPageTitle(event, events)} description={metaDescription} jsonLd={jsonLd}>
  <article class={`event kind-${slugify(event.kind)}`}>
    <header class:list={["head", { dated: isDated(event) }]}>
      {/* The same tile as the front page's card, by the same view-transition name, so one glides into the other. */}
      {isDated(event) && <DateTile tile={dateTile(event, meta.buildToday)} id={event.id} large />}
      <div>
        <p class="kind"><KindChip kind={event.kind} href={kindPath(event.kind)} />{event.dontMiss && <span class="dont-miss">Don't miss</span>}</p>
        <h1 style={`view-transition-name: title-${event.id}`}>{event.title}</h1>
        <p class="date">{line}</p>
        <p class="where"><a href={venuePath(event.venue)}>{venueLine(event)}</a> · {neighborhoodLine(neighborhoodShown(event) ?? event.region, event.region)}</p>
        {admission && <p class="admission">{admission}</p>}
      </div>
    </header>
    {event.whyLine && <p class="why">{event.whyLine}</p>}
    {description && <p class="about">{description}</p>}
    <p class="primary"><a href={details}>Details and tickets at {hostOf(details)}</a></p>
    <div class="actions">
      <EventPageIsland client:load id={event.id} title={event.title} lastDay={lastDay(event)} shareText={`${line} · ${venueLine(event)}`} />
      {isDated(event) && <a class="control" href={`/e/${event.id}.ics`} download><UiIcon name="calendar-plus" />Add to calendar</a>}
      {google !== undefined && <a class="control" href={google} rel="nofollow">Google Calendar</a>}
    </div>
    <p class="verified">{verifiedWhat(event)} {formatShort(localDate(event.lastVerified))} from {event.eventUrl ? <a href={event.primaryUrl}>the list at {hostOf(event.primaryUrl)}</a> : "the page linked above"}.{(event.whyLine || description) && " The reason and description are written by a model."}</p>
    <ReportForm context={report} summary="Wrong? Report it" />
  </article>

  {moreLikeThis.length > 0 && (
    <section aria-labelledby="more">
      <h2 id="more" class="section-heading">More {kindName(event.kind).toLowerCase()}</h2>
      <ul>
        {moreLikeThis.map((e) => (
          <li><a href={`/e/${e.id}`}>{e.title}</a> <span>{formatDay(firstDay(e)!)} · {venueLine(e)}</span></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .event { margin-top: var(--space-8); }
  .head { margin-bottom: var(--space-4); }
  .head.dated { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--space-4); align-items: start; }
  /* The narrowest phones: the tile above the title, which beside it took eight lines at 320 px (audit 2026-10-21, A16). */
  @media (max-width: 26rem) {
    .head.dated { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
  }
  /* Wraps: beside the tile at 320 px, "outdoors/community" and the Don't miss tag together are wider than the column (audit 2026-10-21, A2). */
  .kind { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin: 0; }
  h1 { font-size: var(--text-2xl); line-height: var(--leading-tight); margin: var(--space-2) 0; }
  .date { font-size: var(--text-lg); margin: 0; }
  .where, .admission { color: var(--fg-muted); margin: 0; }
  /* The venue's page; underlined, since the neighborhood follows it on the line (axe link-in-text-block). */
  .where a { color: inherit; text-decoration: underline; }
  /* In ink, as on a pick's card and an explorer row: the reason is what the site adds (#184). */
  .why { margin: 0 0 var(--space-4); font-size: var(--text-lg); max-width: 38rem; }
  .about { margin: 0 0 var(--space-4); max-width: 38rem; }
  .primary { font-size: var(--text-lg); margin: 0 0 var(--space-4); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-bottom: var(--space-6); }
  .verified { font-size: var(--text-xs); color: var(--fg-faint); }
  ul { list-style: none; padding: 0; } li { padding: var(--space-1) 0; } li span { font-size: var(--text-xs); color: var(--fg-faint); }
  /* A link followed by text on the same line must not rely on colour alone (axe link-in-text-block). */
  li a { text-decoration: underline; }
</style>
